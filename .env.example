# ============================================================
# JARVIS 2.0 - Exemplo de Configurações (não commitar o .env real)
# ============================================================

# --- SUPABASE ---
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_KEY=sua_service_role_key

# --- EVOLUTION API ---
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=sua_api_key
EVOLUTION_INSTANCE=nome_da_instancia

# --- OPENAI ---
OPENAI_API_KEY=sk-...

# --- SERVIDOR ---
PORT=3000

# --- FUSO HORÁRIO ---
TIMEZONE=America/Sao_Paulo

# --- WHITELIST ---
# Números autorizados a usar o JARVIS (vírgula separando, sem espaços)
# Formato: 55 + DDD + número (ex: 5567996543700)
# Deixe vazio para liberar para todos
ALLOWED_PHONES=
