# --- SUPABASE ---
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_KEY=sua_service_role_key

# --- EVOLUTION API ---
EVOLUTION_API_URL=https://sua-evolution-api.com
